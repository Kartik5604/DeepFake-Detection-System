model.summary()

# Example: preview face detection and cropping on a single sample image
import cv2
import matplotlib.pyplot as plt
from preprocessing.face_detector import detect_and_crop_face

sample_path = '../data/raw/example/real/sample.jpg'  # update to a real file
image = cv2.imread(sample_path)

if image is not None:
    cropped = detect_and_crop_face(image)
    fig, axes = plt.subplots(1, 2, figsize=(8, 4))
    axes[0].imshow(cv2.cvtColor(image, cv2.COLOR_BGR2RGB))
    axes[0].set_title('Original')
    axes[1].imshow(cv2.cvtColor(cropped, cv2.COLOR_BGR2RGB))
    axes[1].set_title('Cropped Face')
    plt.show()
else:
    print('Update sample_path to point at a real image before running this cell.')


    